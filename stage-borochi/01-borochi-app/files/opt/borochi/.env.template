# Borochi .env-Template
# Wird beim First-Boot mit echten Werten ausgefüllt.

# Wird beim First-Boot generiert: openssl rand -hex 32
BOROCHI_JWT_SECRET=__GENERATED_AT_FIRSTBOOT__
BOROCHI_MASTER_SECRET=__GENERATED_AT_FIRSTBOOT__

# Auto-generierter Token zwischen Agent und Bridge
BOROCHI_AGENT_SHARED_TOKEN=__GENERATED_AT_FIRSTBOOT__

# Origins, die das Frontend laden dürfen
BOROCHI_ALLOWED_ORIGINS=http://borochi.local,https://borochi.local

# Waveshare-IPs — wird von borochi-setup gefüllt
BOROCHI_WAVESHARE_HOSTS=

# Polling-Intervall in Sekunden
BOROCHI_POLL_INTERVAL=5

# Log-Level: DEBUG | INFO | WARNING | ERROR
BOROCHI_LOG_LEVEL=INFO
